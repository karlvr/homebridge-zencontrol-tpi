{
  "compilerOptions": {
    /* Language and Environment — Node >= 22 supports ES2023 natively */
    "target": "ES2023",
    "lib": ["ES2023"],

    /* Modules */
    "module": "NodeNext",

    /* Emit — this config only type-checks; building emits via tsconfig.build.json */
    "noEmit": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,

    /* Completeness */
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test",
  ],
}
